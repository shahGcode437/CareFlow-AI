# CareFlow AI backend — local environment template.
# Copy this file to .env for local development. Never commit the real .env.

APP_NAME="CareFlow AI Backend"
APP_VERSION=0.1.0
ENVIRONMENT=development

HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO

# Comma-separated origins are not supported by default list parsing here;
# for local dev the app defaults to ["*"]. Override only if you need to
# restrict CORS, using a JSON array string, e.g.:
# CORS_ALLOW_ORIGINS=["http://localhost:3000"]
