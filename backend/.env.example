# CareFlow AI backend — local environment template.
# Copy this file to .env for local development. Never commit the real .env.

APP_NAME="CareFlow AI Backend"
APP_VERSION=0.1.0
ENVIRONMENT=development

HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO

# Excel workbook path (Phase 3). Relative paths are resolved against the
# backend project root. Flagged assumption — see app/core/config.py.
EXCEL_FILE_PATH=data/clinic_appointments_MVP_template.xlsx

# Staff-approval policy (Phase 6). Flagged gap — see app/core/config.py:
# no ConfigRepository exists to read this from the workbook's Config
# sheet automatically.
REQUIRE_STAFF_APPROVAL=true

# LLM provider (Phase 7.1). Defaults to "rule_based" — the deterministic,
# no-external-call placeholder — so the app runs with zero configuration.
# To enable the real provider, set:
#   LLM_PROVIDER=groq
#   LLM_API_KEY=<your own Groq API key — never commit a real value>
# LLM_MODEL and LLM_BASE_URL have working defaults; override only if
# swapping to a different OpenAI-compatible provider/model.
LLM_PROVIDER=rule_based
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Knowledge / RAG (Phase 8.8.12). Defaults ship a working configuration
# so the app boots without any RAG env vars set.
#   KNOWLEDGE_DATA_DIR   directory containing doctors.yaml + the two
#                        Markdown files, resolved against the backend
#                        project root when relative.
#   RAG_TOP_K            how many chunks the retriever returns per query.
#   RAG_EMBEDDING_MODEL  a FastEmbed-supported model id. The default
#                        sentence-transformers/all-MiniLM-L6-v2 has a
#                        known 384-dim shape; unknown models still work
#                        (dimension is discovered on first embed).
KNOWLEDGE_DATA_DIR=data/knowledge
RAG_TOP_K=4
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Minimum cosine similarity a retrieved chunk must reach to be
# surfaced. Chunks below this threshold are dropped; if nothing
# passes, the KnowledgeAgent returns the honest "not in the clinic
# knowledge base" fallback instead of surfacing low-confidence
# irrelevant text. Default 0.45 was chosen from measured corpus
# scores (relevant queries >=0.484, irrelevant <=0.439). Set to 0.0
# to disable filtering.
RAG_MIN_SIMILARITY=0.45

# Comma-separated origins are not supported by default list parsing here;
# for local dev the app defaults to ["*"]. Override only if you need to
# restrict CORS, using a JSON array string, e.g.:
# CORS_ALLOW_ORIGINS=["http://localhost:3000"]
