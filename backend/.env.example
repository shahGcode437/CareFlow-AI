# CareFlow AI backend — local environment template.
# Copy this file to .env for local development. Never commit the real .env.

APP_NAME="CareFlow AI Backend"
APP_VERSION=0.1.0
ENVIRONMENT=development

HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO

# Excel workbook path (Phase 3). Relative paths are resolved against the
# backend project root. Flagged assumption — see app/core/config.py.
EXCEL_FILE_PATH=data/clinic_appointments_MVP_template.xlsx

# Staff-approval policy (Phase 6). Flagged gap — see app/core/config.py:
# no ConfigRepository exists to read this from the workbook's Config
# sheet automatically.
REQUIRE_STAFF_APPROVAL=true

# LLM provider (Phase 7.1). Defaults to "rule_based" — the deterministic,
# no-external-call placeholder — so the app runs with zero configuration.
# To enable the real provider, set:
#   LLM_PROVIDER=groq
#   LLM_API_KEY=<your own Groq API key — never commit a real value>
# LLM_MODEL and LLM_BASE_URL have working defaults; override only if
# swapping to a different OpenAI-compatible provider/model.
LLM_PROVIDER=rule_based
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Comma-separated origins are not supported by default list parsing here;
# for local dev the app defaults to ["*"]. Override only if you need to
# restrict CORS, using a JSON array string, e.g.:
# CORS_ALLOW_ORIGINS=["http://localhost:3000"]
